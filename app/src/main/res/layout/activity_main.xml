<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- 服务状态：onResume 期间每秒刷新一次，掉线能立刻看见 -->
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:paddingBottom="12dp"
            android:text="检测中…"
            android:textSize="15sp" />

        <Button
            android:id="@+id/openSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="① 去开启无障碍服务" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/enableSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="② 启用跳广告"
            android:textSize="16sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/topOnlySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="③ 只在屏幕上方 40% 区域找按钮"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="强烈建议保持开启。跳过按钮几乎都在屏幕上方，限制区域能挡掉信息流里的「跳过」字样、设置页的「自动跳过片头片尾」等绝大多数误点。只有遇到把按钮放在底部的 App 才需要关掉。"
            android:textSize="12sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/ocrSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"
            android:text="④ OCR 兜底（识别控件树读不到的广告）"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="部分 App（如 ivy）的开屏广告整屏是视频/图片渲染，无障碍服务物理读不到按钮。开启后：控件树找不到时截图用本地文字识别找「跳过」并点击（每屏最多 2 次，全程本地、不联网）。担心耗电或隐私可关闭。"
            android:textSize="12sp" />

        <Button
            android:id="@+id/resetStateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="重置运行状态（恢复到刚安装，保留设置）" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="自定义关键词"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:paddingTop="6dp"
            android:text="填广告按钮上的文字，一次一个，点「添加」生成标签。\n带数字、带空格都可以，例如：5 跳过、跳过 3s、Skip 5。\n点标签即可删除。"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/keywordInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="输入一个关键词"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="15sp" />

            <Button
                android:id="@+id/addKeyword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:text="添加" />
        </LinearLayout>

        <!-- 关键词标签：代码里动态填充到这个流式布局 -->
        <com.liutiaotiao.FlowLayout
            android:id="@+id/keywordChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/keywordCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="防止服务被系统关掉"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/batteryTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:paddingTop="6dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/batteryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="关闭电池优化（加入白名单）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="被系统关掉后自动恢复（推荐，一次性配置）"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/selfRepairTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:paddingTop="6dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/copyAdbCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="复制 adb 授权命令" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="某个 App 跳不过去？"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:paddingTop="6dp"
            android:text="打开下面的「识别记录」，里面是服务在那个 App 开屏时实际看到的控件（文字、viewId、坐标）以及没点的原因。把内容复制出来就能定位问题。\n注意：如果记录里那一屏一个控件都没有，说明广告是视频/SurfaceView 渲染的，无障碍读不到，任何规则都无效。"
            android:textSize="13sp" />

        <Button
            android:id="@+id/openDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="查看识别记录（诊断）" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="@string/readme"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
